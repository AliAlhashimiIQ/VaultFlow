<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules for devices running Android 12+ (API 31+) -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include the Room database for cloud backup -->
        <include domain="database" path="finance_tracker_db" />
        <include domain="database" path="finance_tracker_db-shm" />
        <include domain="database" path="finance_tracker_db-wal" />
        <!-- Exclude temporary cache -->
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Include the Room database for device-to-device transfer -->
        <include domain="database" path="finance_tracker_db" />
        <include domain="database" path="finance_tracker_db-shm" />
        <include domain="database" path="finance_tracker_db-wal" />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
