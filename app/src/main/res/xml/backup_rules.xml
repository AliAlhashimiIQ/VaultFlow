<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for devices running Android 11 and below (API < 31) -->
<full-backup-content>
    <!-- Include the Room database so users don't lose data -->
    <include domain="database" path="finance_tracker_db" />
    <include domain="database" path="finance_tracker_db-shm" />
    <include domain="database" path="finance_tracker_db-wal" />
    <!-- Exclude temporary cache files (exports, etc.) -->
    <exclude domain="cache" path="." />
</full-backup-content>
